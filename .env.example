# Port d'écoute du serveur (défaut : 3000)
PORT=3000

# Mettre à "true" uniquement derrière un reverse proxy de confiance (nginx, Traefik…).
# Sinon un client pourrait forger X-Forwarded-For et contourner la limite de débit.
TRUST_PROXY=false

# Jeton du lien ADE public qui ouvre l'arbre de toute l'ULCO (son paramètre `data=`).
# Obligatoire : le serveur refuse de démarrer sans lui.
# ADE_TOKEN=...

# Origines autorisées si le front est hébergé sur un autre domaine (liste séparée par des virgules).
# ALLOWED_ORIGINS=https://edt.univ-littoral.fr

# Durées de cache (ms)
CATALOG_TTL_MS=43200000
SCHEDULE_TTL_MS=600000
# Cours réunis de toute l'ULCO, pour les vues salle / enseignant / ressource (~300 flux ADE).
AGGREGATE_TTL_MS=1800000

# Menu du restaurant universitaire (API publique CROUStillant).
# Chaque campus a le sien (clé `crous` des villes, server/config/ade.json) ;
# celui-ci ne sert que pour une formation dont la ville n'en a pas.
# 1164 = R.U. de la Mi-Voix, le restaurant du campus de Calais.
CROUS_RESTAURANT_ID=1164
CROUS_API_BASE=https://api.croustillant.menu/v1
CROUS_TTL_MS=3600000

# ---------------------------------------------------------------------------
# Notifications push
# ---------------------------------------------------------------------------
# Sans clés VAPID, les notifications restent éteintes : le serveur n'expose pas
# les routes d'abonnement et l'application ne propose pas les réglages.
#
# Générer une paire une seule fois :   npm run vapid --workspace=server
# Ne plus en changer ensuite : tous les abonnements en cours seraient perdus,
# et les téléphones cesseraient d'être prévenus sans rien signaler.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact de l'exploitant, exigé par VAPID (`mailto:` ou URL `https:`).
# VAPID_SUBJECT=mailto:contact@example.org

# Fichier des abonnements — la seule donnée que le service écrive sur disque.
# En conteneur, ce chemin doit être sur un volume (voir compose.yaml).
# PUSH_STORE_PATH=./server/data/subscriptions.json

# Rythme du planificateur. Le battement décide des rappels dus ; le relevé
# redemande les emplois du temps à ADE et y cherche des changements.
PUSH_TICK_MS=60000
PUSH_POLL_MS=300000

# ---------------------------------------------------------------------------
# Formulaire de contact (contact, suggestion, problème)
# ---------------------------------------------------------------------------
# Les messages écrits dans l'application partent ici, par courriel. Sans ces
# trois variables, le formulaire reste caché. L'adresse de destination ne
# quitte jamais le serveur : elle n'apparaît ni dans la page, ni dans l'API.
# FEEDBACK_TO=vous@example.org
# Expéditeur, sur un domaine authentifié (SPF/DKIM) chez le service d'envoi.
# FEEDBACK_FROM=EDT ULCO <noreply@edt-iut.online>
#
# SMTP authentifié d'un service d'envoi. Exemple avec Resend :
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# SMTP_SECURE se déduit du port (465 = TLS direct, 587 = STARTTLS).

# ---------------------------------------------------------------------------
# Relais vers ADE (facultatif)
# ---------------------------------------------------------------------------
# Si le pare-feu de l'ULCO refuse l'adresse du serveur, les appels à ADE
# peuvent passer par un Worker Cloudflare (code : relay/worker.js). Les deux
# variables vont ensemble ; la clé est le secret RELAY_KEY du Worker.
# Générer une clé :   openssl rand -hex 32
# ADE_RELAY_URL=https://ade-relais.<votre-compte>.workers.dev
# ADE_RELAY_KEY=
