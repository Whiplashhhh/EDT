# Port d'écoute du serveur (défaut : 3000)
PORT=3000

# Mettre à "true" uniquement derrière un reverse proxy de confiance (nginx, Traefik…).
# Sinon un client pourrait forger X-Forwarded-For et contourner la limite de débit.
TRUST_PROXY=false

# Jetons ADE hors du dépôt : une variable par département,
# ADE_TOKEN_<ID du département en majuscules, tirets remplacés par des underscores>.
# ADE_TOKEN_IUT_INFO=...

# Origines autorisées si le front est hébergé sur un autre domaine (liste séparée par des virgules).
# ALLOWED_ORIGINS=https://edt.univ-littoral.fr

# Durées de cache (ms)
CATALOG_TTL_MS=43200000
SCHEDULE_TTL_MS=600000
